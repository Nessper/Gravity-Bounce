        {
          "weight": 1,
          "lines": [
            { "speakerId": "captain", "text": "That's enough for today. We're heading back." }
          ]
        }
      ]
    },
    {
      "id": "W1_L1_outro",
      "type": "outro",
      "world": 1,
      "level": 1,
      "variants": [
        {
          "weight": 1,
          "lines": [
            { "speakerId": "mike", "text": "Alright... I've seen worse for a first mission." },
            { "speakerId": "rye", "text": "Naturally. That was just the warm-up." },
            { "speakerId": "leigh", "text": "Stable flow. No surprises." },
            { "speakerId": "mike", "text": "Works for me. If every job's like this, I'm in." },
            { "speakerId": "rye", "text": "Maybe wait before you start bragging." },
            { "speakerId": "captain", "text": "Stay focused. We're still a long way from the end of this contract." }
          ]
        }
      ]
    },

    {
      "id": "W1_L2_intro",
      "type": "intro",
      "world": 1,
      "level": 2,
      "variants": [
        {
          "weight": 1,
          "lines": [
            { "speakerId": "leigh", "text": "Flow's a little faster than the last sector." },
            { "speakerId": "mike", "text": "Perfect. I was getting bored." },
            { "speakerId": "rye", "text": "Give you two minutes of boredom and you start screwing up." },
            { "speakerId": "mike", "text": "That's not true. I start screwing up way faster than that." },
            { "speakerId": "leigh", "text": "Angles are less stable. Watch the rebounds." },
            { "speakerId": "mike", "text": "Copy." },
            { "speakerId": "rye", "text": "Mike... I'm on puzzle forty-seven." },
            { "speakerId": "mike", "text": "Wow. That's a huge responsibility." },
            { "speakerId": "captain", "text": "Alright, that's enough. You can mess around later. We've got bins to fill." }
          ]
        }
      ]
    },
    {

    {
      "id": "shop_welcome",
      "type": "shop",
      "world": 0,
      "level": 0,
      "variants": [
        {
          "weight": 1,
          "lines": [
            { "speakerId": "seller", "text": "Welcome to the workshop. If you've got cash, I've got gear." }
          ]
        },
        {
          "weight": 1,
          "lines": [
            { "speakerId": "seller", "text": "Shop's open. If you want to stay alive, I'd suggest outfitting that ship of yours." }
          ]
        },
        {
          "weight": 1,
          "lines": [
            { "speakerId": "seller", "text": "Park the ship, grab a coffee, we'll take care of the rest." }
          ]
        },
        {
          "weight": 1,
          "lines": [
            { "speakerId": "seller", "text": "Repairs, module installs, all kinds of upgrades. Take your time and gear up properly." }
          ]
        }
      ]
    },

    {
      "id": "W1_L1_intro",
      "type": "intro",
      "world": 1,
      "level": 1,
      "variants": [
        {
          "weight": 1,
          "lines": [
            { "speakerId": "captain", "text": "Mike. Easy first pass. You send everything toward the collectors. Let the black ones go." },
            { "speakerId": "mike", "text": "Got it. I won't break anything." },
            { "speakerId": "leigh", "text": "That would be a first." },
            { "speakerId": "rye", "text": "Mike, do your job. I've got a sudoku to finish." },
            { "speakerId": "captain", "text": "Good to see everyone's relaxed. Alright, focus. I want a flawless run." }
          ]
        }
      ]
    },

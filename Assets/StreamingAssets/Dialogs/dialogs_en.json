    {
      "id": "W1_L4_evac",
      "type": "evac",
      "world": 1,
      "level": 4,
      "variants": [
        {
          "weight": 1,
          "lines": [
            { "speakerId": "captain", "text": "Come on, don't linger. Scoop up what's left and lift off." }
          ]
        }
      ]
    },
    {
      "id": "W1_L4_outro",
      "type": "outro",
      "world": 1,
      "level": 4,
      "variants": [
        {
          "weight": 1,
          "lines": [
            { "speakerId": "mike", "text": "Okay... can somebody explain what the hell just happened?" },
            { "speakerId": "rye", "text": "I thought we were done for." },
            { "speakerId": "leigh", "text": "That last wave... the black ratio was far too high." },
            { "speakerId": "mike", "text": "Yeah, I noticed that much." },
            { "speakerId": "mike", "text": "Bad report?" },
            { "speakerId": "leigh", "text": "Possible." },
            { "speakerId": "captain", "text": "It happens." },
            { "speakerId": "rye", "text": "I don't like that kind of mistake." },
            { "speakerId": "captain", "text": "Stay focused. We keep moving." }
          ]
        }
      ]
    },

    {
      "id": "W1_L5_intro",
      "type": "intro",
      "world": 1,
      "level": 5,
      "variants": [
        {
          "weight": 1,
          "lines": [
            { "speakerId": "leigh", "text": "Very heavy flow in this sector." },
            { "speakerId": "mike", "text": "Yeah... I can see that. And honestly, after what happened in the corridor, I'd rather know what I'm walking into." },
            { "speakerId": "rye", "text": "At least this time we're ready." },
            { "speakerId": "leigh", "text": "Trajectories are unstable." },
            { "speakerId": "mike", "text": "Great." },
            { "speakerId": "captain", "text": "Keep a cool head. We do our job." },
            { "speakerId": "mike", "text": "Copy, Captain." }
          ]
        }
      ]
    },

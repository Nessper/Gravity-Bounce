      "world": 1,
      "level": 3,
      "variants": [
        {
          "weight": 1,
          "lines": [
            { "speakerId": "mike", "text": "Alright... that was a little livelier already." },
            { "speakerId": "leigh", "text": "More unstable flow." },
            { "speakerId": "rye", "text": "Still manageable." },
            { "speakerId": "mike", "text": "And your sudoku?" },
            { "speakerId": "rye", "text": "Done." },
            { "speakerId": "mike", "text": "I'm impressed." },
            { "speakerId": "rye", "text": "I knew you'd eventually do something right." },
            { "speakerId": "captain", "text": "Alright. Next stop: the workshop. I'm finally getting a decent cup of coffee." }
          ]
        }
      ]
    },

    {
      "id": "W1_L4_intro",
      "type": "intro",
      "world": 1,
      "level": 4,
      "variants": [
        {
          "weight": 1,
          "lines": [
            { "speakerId": "mike", "text": "Heh... I walked out with the shop girl's number." },
            { "speakerId": "rye", "text": "And I walked out with eight hours of sleep." },
            { "speakerId": "leigh", "text": "Next sector: Rockfall Corridor." },
            { "speakerId": "mike", "text": "That name really fills me with confidence..." },
            { "speakerId": "leigh", "text": "There's something odd in the readings." },
            { "speakerId": "mike", "text": "Odd how?" },
            { "speakerId": "leigh", "text": "Hard to tell." },
            { "speakerId": "captain", "text": "Fine. Then we stay on our guard." },
            { "speakerId": "mike", "text": "Copy, Captain." }
          ]
        }
      ]
    },

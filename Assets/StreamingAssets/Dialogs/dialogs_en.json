    {
      "id": "W1_L2_outro",
      "type": "outro",
      "world": 1,
      "level": 2,
      "variants": [
        {
          "weight": 1,
          "lines": [
            { "speakerId": "mike", "text": "Alright... now it's getting interesting." },
            { "speakerId": "leigh", "text": "Heavier flow, still stable." },
            { "speakerId": "rye", "text": "And my sudoku's coming along nicely." },
            { "speakerId": "mike", "text": "You actually play while we're working?" },
            { "speakerId": "rye", "text": "I play because you're working." },
            { "speakerId": "captain", "text": "Keep it up." }
          ]
        }
      ]
    },

    {
      "id": "W1_L3_intro",
      "type": "intro",
      "world": 1,
      "level": 3,
      "variants": [
        {
          "weight": 1,
          "lines": [
            { "speakerId": "leigh", "text": "Heavier flow in this sector." },
            { "speakerId": "mike", "text": "Ah. There we go. Real work at last." },
            { "speakerId": "rye", "text": "I'm seeing more black ones too." },
            { "speakerId": "leigh", "text": "Confirmed. Ratio's going up." },
            { "speakerId": "mike", "text": "Nothing to worry about." },
            { "speakerId": "captain", "text": "Maybe. But we keep it clean." },
            { "speakerId": "rye", "text": "And after this... I hope that workshop was worth the stop." },
            { "speakerId": "mike", "text": "Oh, absolutely. My flight controls could use a little upgrade." },
            { "speakerId": "captain", "text": "Finish this mission first." }
          ]
        }
      ]
    },

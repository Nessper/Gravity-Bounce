        {
          "weight": 1,
          "lines": [
            { "speakerId": "leigh", "text": "Trigger the flush and see what happens." }
          ]
        }
      ]
    },
    {
      "id": "W1_L1_tutorial_black_hull_success",
      "type": "tutorial",
      "world": 1,
      "level": 1,
      "variants": [
        {
          "weight": 1,
          "lines": [
            { "speakerId": "leigh", "text": "Look at the top left." },
            { "speakerId": "leigh", "text": "You lost 1 hull point." },
            { "speakerId": "leigh", "text": "Watch out for black spheres. If your hull drops to zero, it’s game over." }
          ]
        }
      ]
    },
    {
      "id": "W1_L1_tutorial_outro",
      "type": "tutorial",

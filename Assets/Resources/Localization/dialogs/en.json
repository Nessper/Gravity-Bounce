          "weight": 1,
          "lines": [
            { "speakerId": "leigh", "text": "Before we begin, let’s go over the basics." },
            { "speakerId": "leigh", "text": "We’re moving through an area full of spheres. Our job is to recover them." }
          ]
        }
      ]
    },
